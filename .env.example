# BlockyEdu code-app-web 环境变量
# local：复制为 .env.local
# sit/uat/production：构建时 rsbuild --env-mode <mode> 自动加载对应 .env.<mode>

# local | sit | uat | production
VITE_APP_ENV=local

# API 基址（local 用相对路径 + dev 代理；部署环境用完整 URL）
VITE_API_BASE_URL=/api/v1

# 仅 local dev：Rsbuild /api 代理目标（默认 server :13001）
VITE_API_PROXY_TARGET=http://localhost:13001

# 教育端登录页（SSO 回退）
VITE_EDU_LOGIN_URL=http://localhost:18082/login

# 编程 Web 自身 URL
VITE_CODE_APP_URL=http://localhost:18081
