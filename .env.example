# BlockyEdu code-app-web - coding platform

# blockyedu-full | code-standalone
VITE_DEPLOY_PROFILE=blockyedu-full

VITE_APP_ENV=local
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:13001

# Edu login (leave empty in code-standalone - local login)
VITE_EDU_LOGIN_URL=http://localhost:18082/login
VITE_CODE_APP_URL=http://localhost:18081

# -- LuminaryWorks unified login (Logto OIDC PKCE) --
# Client ID: identity/registered-apps.json -> VibeEdu code-app-web
VITE_IDP_ISSUER=http://localhost:3001/oidc
VITE_IDP_CLIENT_ID=
VITE_IDP_REDIRECT_URI=http://localhost:18081/auth/callback
VITE_IDP_POST_LOGOUT_URI=http://localhost:18081/login

VITE_EDU_APP_URL=http://localhost:18082
VITE_AUTH_EXPERIENCE_URL=http://localhost:18081
VITE_IDP_AUDIENCE=https://api.vibeedu.local
VITE_IDP_TOKEN_KEY=blockyedu_token
VITE_ALLOW_LOCAL_LOGIN=false
